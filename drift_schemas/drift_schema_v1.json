  "fixed_sql": [
    {
      "name": "areas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"areas\" (\"id\" TEXT NOT NULL, \"built_in_key\" TEXT NULL UNIQUE, \"name\" TEXT NULL, \"color_key\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"hidden\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (built_in_key IS NOT NULL OR name IS NOT NULL));"
        }
      ]
    },
    {
      "name": "inbox_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inbox_items\" (\"id\" TEXT NOT NULL, \"text\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"area_id\" TEXT NOT NULL REFERENCES areas (id) ON DELETE RESTRICT, \"room_id\" TEXT NULL, \"title\" TEXT NOT NULL, \"note\" TEXT NULL, \"estimate_min\" INTEGER NULL, \"priority\" TEXT NOT NULL DEFAULT 'b', \"due_date\" TEXT NULL, \"recurrence\" TEXT NULL, \"reminder_at\" INTEGER NULL, \"warn_min\" INTEGER NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (due_date IS NULL OR due_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"occurrences\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id) ON DELETE CASCADE, \"date\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'open', \"started_at\" INTEGER NULL, \"completed_at\" INTEGER NULL, \"actual_min\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"task_id\", \"date\"), CHECK (date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'));"
        }
      ]
    },
    {
      "name": "subtask_checks",
      "sql": [
        {
